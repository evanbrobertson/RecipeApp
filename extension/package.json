{
  "name": "crumb-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src test build.ts && web-ext lint --source-dir dist/firefox --self-hosted",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/chrome": "^0.1.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9",
    "web-ext": "^9.0.0"
  }
}
