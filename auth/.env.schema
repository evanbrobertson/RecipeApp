# crumb-auth's environment variables, in @env-spec format (https://varlock.dev).
#
# The Better Auth service behind AUTH_MODE=hosted (see DEPLOY.md, "Hosted edition"). Only
# Crumb's server talks to it, over a private network. To check a local setup, put values in a
# git-ignored auth/.env.local and run `bunx varlock load` in auth/, or start it with
# `bunx varlock run -- bun src/server.ts`. Values below are the built-in defaults.
#
# @defaultRequired=false @defaultSensitive=false
# ---

# Crumb's public URL: cookies, email links and passkeys belong to this domain (passkeys made on
# one domain don't work on another)
# @required @type=url @example=https://crumb.example.com
SITE_URL=

# Better Auth's signing secret (openssl rand -base64 32)
# @required @sensitive
BETTER_AUTH_SECRET=

# A long random secret shared with Crumb's server. Set the same value there.
# @required @sensitive
AUTH_INTERNAL_SECRET=

# SQLite file. Defaults to auth.db on the Railway volume (RAILWAY_VOLUME_MOUNT_PATH), else
# ./auth.db.
AUTH_DB_PATH=

# Listen address and port. Crumb's AUTH_SERVICE_URL points here.
HOST=::
# @type=port
PORT=3100

# Set by Railway: the volume's mount path
RAILWAY_VOLUME_MOUNT_PATH=

# ---------- Email (Amazon SES) ----------
# With all four set, emails are sent (verification, password reset, invites) and new accounts
# confirm their email. Without them, links are written to the log instead.

# The sender
# @example="Crumb <hello@crumb.example.com>"
EMAIL_FROM=
# SES region (AWS_REGION also works)
# @example=eu-west-1
SES_REGION=
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=

# ---------- Sign in with Google and Apple ----------
# Each provider turns on when all of its values are set. Redirect URL to register:
# {SITE_URL}/api/auth/callback/google (or /apple).

# Google OAuth client ID
# @example=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# Google OAuth client secret
# @sensitive
GOOGLE_CLIENT_SECRET=

# Apple Services ID (not the App ID)
# @example=com.example.crumb.signin
APPLE_CLIENT_ID=
# Apple developer team ID
# @example=ABCDE12345
APPLE_TEAM_ID=
# The Sign in with Apple key's ID
# @example=XYZ987WVUT
APPLE_KEY_ID=
# That key's .p8 file contents (PEM, with \n for newlines)
# @sensitive
APPLE_PRIVATE_KEY=
