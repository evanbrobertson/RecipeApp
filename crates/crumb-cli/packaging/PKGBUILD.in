# Maintainer: Evan Robertson <evan@evanrobertson.dev>
# AUR: crumb-cli-bin. Rendered from PKGBUILD.in by render-pkgbuild.sh; the real file is
# attached to each CLI GitHub Release by cli.yml. @SHA256@ is the release tarball's .sha256.
pkgname=crumb-cli-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Crumb's command line, for agents and scripts (needs a Crumb server and account)"
arch=('x86_64')
url="https://github.com/evanbrobertson/RecipeApp"
license=('MIT')
provides=('crumb')
conflicts=('crumb')
source=("crumb-cli-@VERSION@-x86_64-unknown-linux-musl.tar.gz::https://github.com/evanbrobertson/RecipeApp/releases/download/cli-v@VERSION@/crumb-cli-@VERSION@-x86_64-unknown-linux-musl.tar.gz")
sha256sums=('@SHA256@')

package() {
  local dir="$srcdir/crumb-cli-@VERSION@-x86_64-unknown-linux-musl"
  install -Dm755 "$dir/crumb" "$pkgdir/usr/bin/crumb"
  install -Dm644 "$dir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$dir/SKILL.md" "$pkgdir/usr/share/crumb/skills/crumb/SKILL.md"
}
