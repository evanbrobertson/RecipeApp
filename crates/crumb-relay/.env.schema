# crumb-relay's environment variables, in @env-spec format (https://varlock.dev), like the
# server's own .env.schema. Setup and what the relay is for: docs/RELAY.md.
# A setting that doesn't parse stops the relay starting.
#
# @defaultRequired=false @defaultSensitive=false
# ---

# The shared secret the Crumb server sends as `Authorization: Bearer` (its SCRAPE_RELAY_TOKEN).
# At least 24 characters: openssl rand -hex 32
# @required @sensitive @type=string(minLength=24)
RELAY_TOKEN=

# Address and port to listen on. Set the machine's Tailscale address (tailscale ip -4) so only
# your tailnet can reach it; the default listens on every interface.
# @example=100.101.102.103:8787
RELAY_LISTEN=0.0.0.0:8787

# How this relay is called in the server's log and in /health. Default: the host name.
# @example=pi1
RELAY_NAME=

# The least time between two fetches from the same site, in seconds (0 = no wait). A home IP
# that hammers a site gets blocked like the datacenter's did.
# @type=number(min=0, isInt=true)
RELAY_HOST_INTERVAL_SECS=5

# Fetches running at once; more are answered 429
# @type=number(min=1, isInt=true)
RELAY_CONCURRENCY=2

# Fetches started in any minute; more are answered 429
# @type=number(min=1, isInt=true)
RELAY_PER_MINUTE=20

# Log level (tracing filter)
# @example=info
RUST_LOG=info
