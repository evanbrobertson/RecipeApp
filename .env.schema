# Crumb's environment variables, in @env-spec format (https://varlock.dev).
#
# Every setting the server reads is listed here with its type, whether it's required and
# whether it's a secret. It's a plain .env file, so it reads fine without any tools. To check a
# local setup against it, put your values in a git-ignored .env.local and run
#   bunx varlock load                 # validates, secrets masked
#   bunx varlock run -- cargo run     # starts the server with them
# On Railway, set the same names as service variables. Values below are the built-in defaults.
# The auth service for AUTH_MODE=hosted has its own list in auth/.env.schema.
# The older NUXT_APP_PASSWORD, NUXT_ANTHROPIC_API_KEY, NUXT_ANTHROPIC_MODEL and
# NUXT_PUBLIC_SITE_URL names are still read as fallbacks.
#
# @defaultRequired=false @defaultSensitive=false
# ---

# ---------- Signing in ----------

# How people sign in:
# - password: one shared APP_PASSWORD
# - accounts: email and password per person, one recipe box per household; the first account
#   owns the existing box
# - hosted: the same, through the Better Auth service in auth/ (see DEPLOY.md)
# @type=enum(password, accounts, hosted)
AUTH_MODE=password

# Password for the web app and for approving the Claude connector (AUTH_MODE=password).
# Required in production: without it the app is public. Leave empty only for local development.
# Changing it signs out every browser.
# @sensitive
APP_PASSWORD=

# With AUTH_MODE=accounts: open lets anyone make an account with a new, empty box. Off by
# default (invite links still work).
# @type=enum(open)
SIGNUP=

# ---------- Hosted edition (AUTH_MODE=hosted) ----------

# The auth service's private URL
# @required=eq($AUTH_MODE, hosted) @type=url
# @example=http://crumb-auth.railway.internal:3100
AUTH_SERVICE_URL=

# A long random secret shared with the auth service (openssl rand -base64 32). Set the same
# value there.
# @required=eq($AUTH_MODE, hosted) @sensitive
AUTH_INTERNAL_SECRET=

# The email whose household takes over the recipes already in the database. Set it before that
# account first signs in; otherwise every household starts with an empty box.
# @type=email @example=you@example.com
HOSTED_HOME_OWNER=

# ---------- Sign in with Google and Apple (accounts; hosted: set these on the auth service) ----------
# Redirect URI to register with the provider:
#   accounts: {SITE_URL}/api/auth/social/{google,apple}/callback
#   hosted:   {SITE_URL}/api/auth/callback/{google,apple}
# Each provider turns on when all of its values are set.

# Google OAuth client ID (Google Cloud console → Credentials → OAuth client ID, type Web)
# @example=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# Google OAuth client secret
# @sensitive
GOOGLE_CLIENT_SECRET=

# Apple Services ID (not the App ID)
# @example=com.example.crumb.signin
APPLE_CLIENT_ID=
# Apple developer team ID
# @example=ABCDE12345
APPLE_TEAM_ID=
# The Sign in with Apple key's ID
# @example=XYZ987WVUT
APPLE_KEY_ID=
# That key's .p8 file contents (PEM, with \n for newlines)
# @sensitive
APPLE_PRIVATE_KEY=

# ---------- Where it runs ----------

# Public URL of the app, for OAuth, the connector URL and sign-in links. Only needed with a
# custom domain: on Railway, RAILWAY_PUBLIC_DOMAIN is used automatically.
# @type=url @example=https://recipes.example.com
SITE_URL=

# SQLite file. Defaults to recipes.db on the Railway volume (RAILWAY_VOLUME_MOUNT_PATH), else
# .data/recipes.db. Household boxes, accounts.db and the image cache live beside it.
# @example=/data/recipes.db
DATABASE_PATH=

# Built frontend directory (run `bun run build` in web/)
WEB_DIST=web/dist

# Listen address
HOST=0.0.0.0
# Listen port (Railway sets this)
# @type=port
PORT=3000

# Set by Railway, never by hand: the generated domain (a SITE_URL fallback), the volume's mount
# path (where the database goes) and the environment name (trusts its proxy's headers)
RAILWAY_PUBLIC_DOMAIN=
RAILWAY_VOLUME_MOUNT_PATH=
RAILWAY_ENVIRONMENT=

# ---------- Wee Chef (AI) ----------
# A key turns on Wee Chef: it reads pasted text, files and photos, and writes "Try next" blurbs
# and recipe ideas. Without one, a built-in parser and the plain algorithm are used. Set one
# provider's key.

# @sensitive @type=string(startsWith=sk-ant-)
# @docs(https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# @type=url
ANTHROPIC_BASE_URL=https://api.anthropic.com

# @sensitive @type=string(startsWith=sk-)
# @docs(https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# @type=url
OPENAI_BASE_URL=https://api.openai.com/v1

# @sensitive @type=string(startsWith=sk-)
# @docs(https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# @type=url
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Which provider to use when several keys are set. Default: the first with a key, in the
# order anthropic, openai, deepseek.
# @type=enum(anthropic, openai, deepseek)
LLM_PROVIDER=

# A different (e.g. cheaper) model for "Try next" blurbs and ideas. Default: the main model.
SUGGEST_MODEL=
# The model that reads recipe photos. Default: the main model (deepseek-flash on DeepSeek).
VISION_MODEL=
# off keeps "Try next" algorithm-only (pasted text is still read by Wee Chef)
# @example=off
SUGGESTIONS_AI=

# ---------- Wee Chef's recipe check (TypeSafe) ----------
# Checks every imported recipe in the background, fixes clear extraction mistakes (with Undo)
# and flags the rest in the editor. About $0.0005 a recipe. Unset = off.

# @sensitive
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# @type=url
TYPESAFE_BASE_URL=https://api.typesafe.ai
# off turns the check off, even with TYPESAFE_API_KEY set
# @example=off
CHECKS_AI=

# ---------- Scraping ----------

# Chromium for the headless fallback on sites that block or need JavaScript. Set in the Docker
# image, auto-detected elsewhere. (Leave Chromium out of the image with the build arg
# WITH_CHROMIUM=false.)
CHROMIUM_PATH=
# off disables the headless browser fallback
# @type=enum(off)
BROWSER_SCRAPING=

# Chromium runs in its sandbox unless this is 1. Some hosts (containers without unprivileged
# user namespaces, possibly Railway) cannot start it sandboxed; the log then says so, and setting
# this is an informed choice to open untrusted pages unsandboxed (the image runs as a non-root user).
# @type=boolean
BROWSER_NO_SANDBOX=

# ---------- Cooking videos (TikTok, Reels, Shorts) ----------

# off stops videos being downloaded (their captions are still read)
# @type=enum(off)
VIDEO_IMPORT=
# The video tools. Set in the Docker image, else found on PATH.
YT_DLP_PATH=
FFMPEG_PATH=
WHISPER_PATH=
# The whisper.cpp model file
WHISPER_MODEL=/opt/video/models/ggml-base.en.bin
# Videos processed at once, about 400 MB of RAM each at their peak (README has a sizing table)
# @type=number(min=1, isInt=true)
VIDEO_WORKERS=1
# Videos that may wait beyond those; past that, imports get a 429. Default: 4 per worker.
# @type=number(min=0, isInt=true)
VIDEO_QUEUE_MAX=
# Threads per transcription. Default: the cores split between the workers (at most 8).
# @type=number(min=1, isInt=true)
WHISPER_THREADS=

# ---------- Sentry (errors and tracing, server and browser) ----------
# Strictly opt-in: unset, nothing is sent and pages load no Sentry code.

# @type=url @docs(https://docs.sentry.io/concepts/key-terms/dsn-explainer/)
SENTRY_DSN=
# The hosted app uses dev and stable
SENTRY_ENVIRONMENT=production
# Release name. Set in the Docker image by CI; default crumb@<version>.
SENTRY_RELEASE=
# Share of server requests traced
# @type=number(min=0, max=1)
SENTRY_TRACES_SAMPLE_RATE=0.1
# off keeps the browser SDK from loading while the server still reports
# @type=enum(off)
SENTRY_BROWSER=
