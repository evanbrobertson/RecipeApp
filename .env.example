# Password for the web app and for approving the Claude connector.
# Required in production; leave empty only for local development.
APP_PASSWORD=

# Public URL of the app (optional on Railway: RAILWAY_PUBLIC_DOMAIN is used automatically)
SITE_URL=

# SQLite file location. On Railway, attach a volume (any mount path) and the database is
# stored on it automatically via RAILWAY_VOLUME_MOUNT_PATH. Defaults to .data/recipes.db.
DATABASE_PATH=

# Optional: a key turns on Wee Chef, the AI helper that cleans up recipes pasted on the Add page
# and writes "Try next" blurbs and recipe ideas. Without a key, a built-in parser and the plain
# algorithm are used. Set one provider's key; LLM_PROVIDER picks one when several are set
# (anthropic, openai, deepseek).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# LLM_PROVIDER=
# A different model for Wee Chef's "Try next" picks and ideas. Wee Chef is on whenever a key is
# set; SUGGESTIONS_AI=off keeps Try next algorithm-only (pasted text is still cleaned up)
# SUGGEST_MODEL=
# The model that reads recipe photos (default: the main model; on DeepSeek, deepseek-flash)
# VISION_MODEL=
# SUGGESTIONS_AI=off

# Optional: Wee Chef checks every imported recipe (URL, pasted text, files; not backups) with
# TypeSafe's Jev classifier in the background, fixes clear extraction mistakes (headings saved
# as ingredients or steps, split steps, tips in the method, junk lines) with Undo, and flags the
# rest in the editor. About $0.0005 a recipe. Unset = off; CHECKS_AI=off turns it off with a key.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-1.13.0
# CHECKS_AI=off

# Where the built frontend lives (web/dist after `bun run build` in web/)
WEB_DIST=web/dist

# Optional: error reporting and tracing with Sentry, for the server and the browser. Unset = off.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_BROWSER=off
