# Password for the web app and for approving the Claude connector.
# Required in production; leave empty only for local development.
APP_PASSWORD=

# Public URL of the app (optional on Railway: RAILWAY_PUBLIC_DOMAIN is used automatically)
SITE_URL=

# SQLite file location. On Railway, attach a volume (any mount path) and the database is
# stored on it automatically via RAILWAY_VOLUME_MOUNT_PATH. Defaults to .data/recipes.db.
DATABASE_PATH=

# Optional: an AI model cleans up recipes pasted on the Add page and writes "Try next" blurbs.
# Without a key, a built-in parser and the plain algorithm are used. Set one provider's key;
# LLM_PROVIDER picks one when several are set (anthropic, openai, deepseek).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# LLM_PROVIDER=
# A different model for "Try next" blurbs, and a switch to turn the AI part off
# SUGGEST_MODEL=
# SUGGESTIONS_AI=off

# Where the built frontend lives (web/dist after `bun run build` in web/)
WEB_DIST=web/dist
