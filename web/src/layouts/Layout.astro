---
/**
 * The page shell: head, fonts, header, mobile tab bar, timers and toasts.
 *
 * Pages are static HTML. Anything that depends on your recipes is a Svelte island
 * that reads the JSON the Rust server inlines as #page-data, so a page paints in
 * one round trip with no follow-up fetch.
 */
import Icon from "../components/Icon.astro"
import { House, BookOpenText, LibraryBig, Ellipsis, Plus } from "lucide"
import "../styles/app.css"
import nunito from "../assets/fonts/nunito-sans.woff2?url"
import dmSerif from "../assets/fonts/dm-serif-display.woff2?url"
import caveat from "../assets/fonts/caveat.woff2?url"
import themeBoot from "../lib/theme-boot.js?raw"
import transitionsBoot from "../lib/transitions-boot.js?raw"
import TimerDock from "../islands/TimerDock.svelte"

export type Section = "kitchen" | "recipes" | "shelf" | "more" | "add" | null

interface Props {
  title?: string
  /** Which nav item is highlighted. */
  section?: Section
  /** No nav (sign-in, cook mode). */
  bare?: boolean
  /** Browser chrome colour for this page, light and dark (cook mode matches its tile header). */
  themeColor?: string | { light: string; dark: string }
  /** This page has server-inlined data (see the Rust page-data table). */
  data?: boolean
  bodyClass?: string
  /** The page uses the handwriting face above the fold (Home's greeting). */
  hand?: boolean
}

const { title, section = null, bare = false, themeColor, data = false, bodyClass, hand = false } =
  Astro.props
const fullTitle = title ? `${title} · Crumb` : "Crumb"
const chrome =
  typeof themeColor === "string"
    ? { light: themeColor, dark: themeColor }
    : (themeColor ?? { light: "#f5f1e6", dark: "#141c17" })

const links = [
  { href: "/", label: "Home", key: "kitchen", icon: House },
  { href: "/recipes", label: "Recipes", key: "recipes", icon: BookOpenText },
  { href: "/cookbooks", label: "Shelf", key: "shelf", icon: LibraryBig },
  { href: "/more", label: "More", key: "more", icon: Ellipsis },
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content="Recipes, minus the life story." />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="theme-color"
      content={chrome.light}
      data-light={chrome.light}
      data-dark={chrome.dark}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={nunito} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSerif} as="font" type="font/woff2" crossorigin />
    {hand && <link rel="preload" href={caveat} as="font" type="font/woff2" crossorigin />}
    <style
      set:html={`
      @font-face{font-family:"Nunito Sans";src:url(${nunito}) format("woff2");font-weight:200 1000;font-display:swap}
      @font-face{font-family:"DM Serif Display";src:url(${dmSerif}) format("woff2");font-weight:400;font-display:swap}
      @font-face{font-family:"Caveat";src:url(${caveat}) format("woff2");font-weight:700;font-display:swap}
    `}
    />
    <!-- Theme before first paint: light, dark, system, or sunrise/sunset -->
    <script is:inline set:html={themeBoot} />
    <script is:inline set:html={transitionsBoot} />
  </head>
  <body class={bodyClass}>
    {data && <script type="application/json" id="page-data">null</script>}
    {
      bare ? (
        <slot />
      ) : (
        <div class="min-h-dvh md:pl-60">
          <nav
            class="bg-nav fixed inset-y-0 left-0 z-40 hidden w-60 flex-col gap-1 px-4 py-6 md:flex"
            style="view-transition-name: nav"
            aria-label="Main"
          >
            <a href="/" class="page-title mb-6 px-3 text-[#fffdf8]">
              Crumb
            </a>
            {links.map((l) => (
              <a
                href={l.href}
                class:list={[
                  "rounded-ctl flex h-12 items-center gap-3 px-3 text-[15px] transition hover:bg-white/5",
                  section === l.key ? "text-butter font-bold" : "text-nav-ink font-semibold",
                ]}
                aria-current={section === l.key ? "page" : undefined}
              >
                <Icon icon={l.icon} class="size-[22px]" />
                {l.label}
              </a>
            ))}
            <a href="/add" class="btn btn-primary mt-6">
              <Icon icon={Plus} />
              Add recipe
            </a>
          </nav>

          <slot name="hero" />

          <main class="mx-auto max-w-[75rem] px-5 pt-6 pb-32 sm:pt-8 md:px-8 md:pb-16">
            <slot />
          </main>

          <nav
            class="bg-nav fixed inset-x-0 bottom-0 z-40 px-2 pt-2 pb-[max(env(safe-area-inset-bottom),0.875rem)] md:hidden"
            style="view-transition-name: nav"
            aria-label="Tabs"
          >
            <div class="grid grid-cols-4">
              {links.map((l) => (
                <a
                  href={l.href}
                  class:list={[
                    "flex h-[52px] flex-col items-center justify-center gap-1 text-[13px] transition",
                    section === l.key ? "text-butter font-bold" : "text-nav-ink font-semibold",
                  ]}
                  aria-current={section === l.key ? "page" : undefined}
                >
                  <Icon icon={l.icon} class="size-[22px]" />
                  {l.label}
                </a>
              ))}
            </div>
          </nav>
        </div>
      )
    }

    <!-- Kitchen timers keep ticking on every page -->
    <!-- Above the phone tab bar, bottom of the screen on wider ones: clear of page titles -->
    <div
      data-timer-dock
      class="pointer-events-none fixed inset-x-0 bottom-[calc(max(env(safe-area-inset-bottom),0.875rem)+4.75rem)] z-50 px-4 md:bottom-6 md:left-60"
    >
      <TimerDock client:only="svelte" />
    </div>

    <script>
      import { showFlash } from "../lib/toast"
      showFlash()

    </script>
  </body>
</html>
