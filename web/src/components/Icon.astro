---
/** A Lucide icon as plain inline SVG (no JavaScript), for .astro files. */
import type { IconNode } from "lucide"

interface Props {
  icon: IconNode
  class?: string
}
const { icon, class: className } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    icon.map(([Tag, attrs]) => {
      const T = Tag as string
      return <T {...attrs} />
    })
  }
</svg>
