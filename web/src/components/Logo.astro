---
/** The Crumb mark: a bitten cookie on a tomato squircle. Same drawing as /favicon.svg. */
interface Props {
  class?: string
}
const { class: className } = Astro.props
const id = `bite-${Math.random().toString(36).slice(2, 8)}`
---

<svg class={className} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <mask id={id}>
      <rect width="64" height="64" fill="#fff"></rect>
      <circle cx="47.5" cy="15" r="8.5" fill="#000"></circle>
      <circle cx="53" cy="25" r="6.8" fill="#000"></circle>
      <circle cx="39" cy="10.5" r="5.5" fill="#000"></circle>
    </mask>
  </defs>
  <rect width="64" height="64" rx="16" fill="#ee5a3a"></rect>
  <g mask={`url(#${id})`}>
    <circle cx="32.5" cy="36" r="20" fill="#9c5a2c" opacity=".35"></circle>
    <circle cx="31" cy="34" r="20" fill="#f8d59a"></circle>
    <circle cx="31" cy="34" r="20" fill="none" stroke="#e7b36a" stroke-width="2.2"></circle>
  </g>
  <g fill="#6b3a22">
    <ellipse cx="23" cy="28" rx="3.2" ry="2.8" transform="rotate(-20 23 28)"></ellipse>
    <ellipse cx="34" cy="40" rx="3" ry="2.6" transform="rotate(15 34 40)"></ellipse>
    <ellipse cx="22.5" cy="42" rx="2.4" ry="2.1"></ellipse>
    <ellipse cx="35" cy="27.5" rx="2.3" ry="2"></ellipse>
    <ellipse cx="42" cy="37" rx="2" ry="1.8"></ellipse>
  </g>
  <g fill="#f8d59a">
    <circle cx="54" cy="36.5" r="2"></circle>
    <circle cx="57.5" cy="31" r="1.3"></circle>
    <circle cx="51" cy="42" r="1.2"></circle>
  </g>
</svg>
