---
import Icon from "../components/Icon.astro"
import { MessageSquareQuote } from "lucide"
import Layout from "../layouts/Layout.astro"
import ConnectorUrl from "../islands/ConnectorUrl.svelte"

const examples = [
  "Save this recipe to my recipe box: [paste recipe]",
  "Import the recipe from https://…",
  "What can I make with chicken thighs and lemons from my saved recipes?",
  "Double my banana bread recipe and save the changes.",
  "Add my lasagne and tiramisu to a cookbook called Sunday dinner.",
]
---

<Layout title="Connect Claude" section="more" data>
  <div class="mx-auto max-w-5xl space-y-7">
    <div class="max-w-2xl">
      <h1 class="page-title">Connect to Claude</h1>
      <p class="text-ink-muted mt-2">
        Add Crumb as a connector in Claude. Then you can paste recipes into any chat, ask Claude to
        save them, search your collection, or have Claude adapt a saved recipe.
      </p>
    </div>

    <div class="grid gap-7 lg:grid-cols-2 lg:gap-8">
      <div class="min-w-0 space-y-7">
        <div>
          <ConnectorUrl client:only="svelte" part="url">
            <div slot="fallback" class="skeleton rounded-ui h-32"></div>
          </ConnectorUrl>
        </div>

        <section>
          <h2 class="section-title mb-3.5">Claude on the web, desktop and mobile</h2>
          <ol class="list-card">
            <li class="list-row items-start">
              <span class="well font-bold">1</span>
              <span class="flex-1 self-center">
                In Claude, open <strong>Settings → Connectors</strong>.
              </span>
            </li>
            <li class="list-row items-start">
              <span class="well font-bold">2</span>
              <span class="flex-1 self-center">
                Choose <strong>Add custom connector</strong>, name it “Crumb” and paste the URL above.
              </span>
            </li>
            <li class="list-row items-start">
              <span class="well font-bold">3</span>
              <span class="flex-1 self-center">
                Click <strong>Connect</strong>. You'll be sent here to approve it with your app
                password.
              </span>
            </li>
            <li class="list-row items-start">
              <span class="well font-bold">4</span>
              <span class="flex-1 self-center">
                In a chat, make sure the connector is switched on in the tools menu, then ask away.
              </span>
            </li>
          </ol>
          <p class="text-ink-muted mt-3 text-sm">
            Connectors you add on claude.ai are also available in the Claude mobile apps. On Team and
            Enterprise plans an owner may need to add the connector for the organisation first.
          </p>
        </section>
      </div>

      <div class="min-w-0 space-y-7">
        <section>
          <h2 class="section-title mb-3.5">Claude Code</h2>
          <ConnectorUrl client:only="svelte" part="code">
            <div slot="fallback" class="skeleton h-14"></div>
          </ConnectorUrl>
          <p class="text-ink-muted mt-2 text-sm">
            Then run <code class="text-ink font-bold">/mcp</code> in Claude Code to sign in.
          </p>
        </section>

        <section>
          <h2 class="section-title mb-3.5">Things to try</h2>
          <ul class="list-card">
            {
              examples.map((ex) => (
                <li class="list-row">
                  <span class="well">
                    <Icon icon={MessageSquareQuote} />
                  </span>
                  <span class="flex-1 text-[15px]">“{ex}”</span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </div>
</Layout>
