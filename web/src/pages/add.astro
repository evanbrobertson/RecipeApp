---
import Icon from "../components/Icon.astro"
import { Link, ClipboardType, List, PenLine, FileDown, ChevronRight } from "lucide"
import Layout from "../layouts/Layout.astro"
import TopBox from "../islands/TopBox.svelte"

const tips = [
  {
    icon: Link,
    title: "A link",
    text: "Most recipe sites work. If one blocks us, a real browser has a go.",
  },
  {
    icon: ClipboardType,
    title: "Any recipe text",
    text: "From an email, notes, a PDF or a photo's text. Headings help but aren't required.",
  },
  {
    icon: List,
    title: "Lots of links",
    text: "Paste several at once and they're imported one after another.",
  },
]
---

<Layout title="Add a recipe" section="add">
  <div class="mx-auto max-w-3xl space-y-7">
    <div>
      <h1 class="page-title">Add a recipe</h1>
      <p class="text-ink-muted mt-2">Paste a link or the recipe itself.</p>
      <div class="mt-5"><TopBox client:load tabs={false} onTile={false} autofocus /></div>
    </div>

    <section>
      <h2 class="section-title mb-3.5">What you can paste</h2>
      <div class="list-card">
        {
          tips.map((tip) => (
            <div class="list-row">
              <span class="well">
                <Icon icon={tip.icon} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[17px] leading-tight font-bold">{tip.title}</span>
                <span class="text-ink-muted block text-sm">{tip.text}</span>
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="section-title mb-3.5">Other ways in</h2>
      <div class="list-card">
        <a href="/recipes/new" class="list-row">
          <span class="well"><Icon icon={PenLine} /></span>
          <span class="min-w-0 flex-1">
            <span class="block text-[17px] leading-tight font-bold">Write from scratch</span>
            <span class="text-ink-muted block text-sm">Grandma's card, your own creation</span>
          </span>
          <Icon icon={ChevronRight} class="text-ink-muted size-5 flex-none" />
        </a>
        <a href="/import" class="list-row">
          <span class="well"><Icon icon={FileDown} /></span>
          <span class="min-w-0 flex-1">
            <span class="block text-[17px] leading-tight font-bold">Import from another app</span>
            <span class="text-ink-muted block text-sm">Just the Recipe, Paprika, Mealie…</span>
          </span>
          <Icon icon={ChevronRight} class="text-ink-muted size-5 flex-none" />
        </a>
      </div>
    </section>
  </div>
</Layout>
