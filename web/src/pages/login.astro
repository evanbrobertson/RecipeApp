---
import Layout from "../layouts/Layout.astro"
import Logo from "../components/Logo.astro"
import LoginForm from "../islands/LoginForm.svelte"
---

<Layout title="Sign in" bare>
  <div class="grid min-h-dvh place-items-center px-4 py-10">
    <div class="w-full max-w-sm">
      <div class="mb-6 flex flex-col items-center text-center">
        <Logo class="size-14" />
        <h1 class="mt-3 font-serif text-3xl font-semibold">Crumb</h1>
        <p class="text-ink-muted text-sm">Enter your password to open your recipe box.</p>
      </div>
      <LoginForm client:load />
    </div>
  </div>
</Layout>
