---
import Icon from "../components/Icon.astro"
import { Archive, ChevronRight, Download, FileDown, PenLine, Plug, Shuffle } from "lucide"
import Layout from "../layouts/Layout.astro"
import MoreSettings from "../islands/MoreSettings.svelte"
import type { IconNode } from "lucide"

interface Row {
  href: string
  icon: IconNode
  label: string
  text?: string
  random?: boolean
  download?: boolean
}

const groups: { title: string; rows: Row[] }[] = [
  {
    title: "Your recipes",
    rows: [
      { href: "/random", icon: Shuffle, label: "Surprise me", random: true },
      { href: "/recipes/new", icon: PenLine, label: "Write a recipe" },
      {
        href: "/import",
        icon: FileDown,
        label: "Import recipes",
        text: "Links, files, Paprika, Mealie",
      },
    ],
  },
  {
    title: "Claude & backups",
    rows: [
      { href: "/connect", icon: Plug, label: "Connect to Claude" },
      {
        href: "/api/export",
        icon: Archive,
        label: "Download a backup",
        text: "Everything as one JSON file",
        download: true,
      },
    ],
  },
]
---

<Layout title="More" section="more" data>
  <div class="mx-auto flex max-w-[600px] flex-col gap-8">
    <h1 class="page-title">More</h1>

    {
      groups.map((g) => (
        <section>
          <h2 class="settings-heading">{g.title}</h2>
          <div class="list-card">
            {g.rows.map((r) => (
              <a
                href={r.href}
                class="list-row settings-row"
                download={r.download}
                data-random={r.random}
                data-no-prerender={r.random}
              >
                <Icon icon={r.icon} class="settings-icon" />
                <span class="min-w-0 flex-1">
                  <span class="block font-bold">{r.label}</span>
                  {r.text && <span class="text-ink-muted block text-sm">{r.text}</span>}
                </span>
                <Icon
                  icon={r.download ? Download : ChevronRight}
                  class="text-ink-muted size-5 flex-none"
                />
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <MoreSettings client:only="svelte">
      <div slot="fallback" class="space-y-8">
        <div class="skeleton rounded-ui h-[17rem]"></div>
        <div class="skeleton rounded-ui h-40"></div>
      </div>
    </MoreSettings>
  </div>
</Layout>

<script>
  import { wireRandomLinks } from "../lib/random"
  wireRandomLinks()
</script>
