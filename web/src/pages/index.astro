---
import Layout from "../layouts/Layout.astro"
import TopBox from "../islands/TopBox.svelte"
import HomeFeed from "../islands/HomeFeed.svelte"
import GridSkeleton from "../components/GridSkeleton.svelte"
---

<Layout
  title="Home"
  section="kitchen"
  data
  hand
  themeColor={{ light: "#2f6b4f", dark: "#1f3d2e" }}
>
  <header slot="hero" class="tile-surface">
    <div class="mx-auto flex max-w-[75rem] flex-col gap-3.5 px-5 pt-[calc(env(safe-area-inset-top)+1.375rem)] pb-6 md:px-8 md:pt-10 md:pb-9">
      <a href="/" class="page-title text-on-tile w-fit md:hidden">Crumb</a>
      <p class="hand mb-1.5 text-[2.375rem] md:text-5xl" id="greeting">what's cooking tonight?</p>
      <!-- Set before first paint: the greeting follows the viewer's clock -->
      <script is:inline>
        ;(() => {
          const h = new Date().getHours()
          document.getElementById("greeting").textContent =
            h < 5
              ? "midnight snack?"
              : h < 11
                ? "what's for breakfast?"
                : h < 15
                  ? "what's for lunch?"
                  : h < 21
                    ? "what's cooking tonight?"
                    : "something sweet?"
        })()
      </script>
      <div class="w-full max-w-[40rem]">
        <TopBox client:load />
      </div>
    </div>
  </header>

  <HomeFeed client:only="svelte">
    <div slot="fallback"><GridSkeleton count={4} /></div>
  </HomeFeed>
</Layout>
